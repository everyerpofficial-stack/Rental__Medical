# Google Sheets Database Sync & OTP Email Web App URL
# 1. Follow the setup guide in Settings -> Database tab inside the ERP
# 2. Deploy your Google Apps Script
# 3. Paste your Apps Script Web App URL below
# ⚠️  NEVER commit your real URL here — add it to .env (which is git-ignored)
VITE_GSHEETS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID_HERE/exec

# WhatsApp Cloud API
# There is deliberately no VITE_WHATSAPP_* entry here. A Meta access token
# must never be a VITE_ variable: Vite inlines those into the public bundle.
# Configure WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_ACCESS_TOKEN as Script
# Properties in the Google Apps Script project instead - see Settings ->
# WhatsApp inside the ERP for the full setup steps.
